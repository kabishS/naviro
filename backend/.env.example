# ==============================================================================
# Rover Path Planning Backend Environment Variables
# ==============================================================================

# Server Port
PORT=3000

# Allowed Frontend Origins for CORS (use * for all or http://localhost:8080)
FRONTEND_URL=*

# PX4 SITL & Autopilot Bridge Settings (Optional)
PX4_ENABLED=false
PX4_CONNECTION_URL=udp://127.0.0.1:14540
PX4_HEARTBEAT_TIMEOUT_MS=3000

# ROS 2 Integration Settings (Optional)
ROS2_ENABLED=false
ROS2_DOMAIN_ID=0
ROS2_NODE_NAME=rover_path_bridge
